local CACHE_ROOT = "pshade_cache"
local CACHE_VER  = CACHE_ROOT.."/.version"

local function ensureFolder(path)
	if not hasfs or not fsmkdir then return end
	local parts={}
	for p in path:gmatch("[^/]+") do parts[#parts+1]=p end
	local cur=""
	for i=1,#parts do
		cur=(i==1) and parts[i] or (cur.."/"..parts[i])
		pcall(fsmkdir,cur)
	end
end

local cacheReady=false
if hasfs then
	ensureFolder(CACHE_ROOT)
	ensureFolder(CACHE_ROOT.."/files")
	if fsexists(CACHE_VER) then
		local ok,v=pcall(fsread,CACHE_VER)
		if ok and v and v:gsub("%s+$","")==VERSION then cacheReady=true end
	end
	-- We write/refresh the version stamp immediately after preloading completes
end

local cachePathCache={}
local function cachePathFor(url)
	local p=cachePathCache[url]
	if p then return p end
	local prefix=""
	for i=1,math.min(#url,20) do
		prefix=prefix..string.format("%02x",url:byte(i))
	end
	prefix=prefix:sub(1,10)
	local base=url:match("([^/]+)$") or "file"
	base=base:gsub("%%","pct"):gsub("[^%w_%-%.]","_")
	if #base<2 or #base>80 then
		base=url:gsub("^https?://",""):gsub("[^%w_%-%.]","_")
		if #base>80 then base=base:sub(-80) end
	end
	p=CACHE_ROOT.."/files/"..prefix.."_"..base
	cachePathCache[url]=p
	return p
end

local function evalRaw(raw)
	if not raw or raw=="" then return nil end
	if raw:sub(1,1)=="<" then return nil end
	if raw:match("^%s*429") or raw:match("Too Many Requests") then return nil end
	if raw:match("^%s*404") or raw:match("Not Found") then return nil end
	if raw:match("^%s*500") or raw:match("Internal Server Error") then return nil end

	local f=loadstring(raw)
	if f then
		local s,r=pcall(f)
		if s and r~=nil then return r end
	end
	local ok,j=pcall(function() return http:JSONDecode(raw) end)
	if ok then return j end
	return nil
end

-- Single-file raw fetch with disk cache (no evalRaw here)
local rawPathForURL = {}
local function cachedRaw(url)
	local cp=cachePathFor(url)
	if cacheReady and fsexists(cp) then
		local ok,data=pcall(fsread,cp)
		if ok and data and #data>0 then
			return data, true  -- raw, from cache
		end
	end
	local ok,raw=pcall(function() return game:HttpGet(url) end)
	if not ok or not raw then return nil, false end
	if hasfs then pcall(fswrite,cp,raw) end
	return raw, false
end

local function cachedLoad(url)
	local raw=cachedRaw(url)
	if not raw then return nil end
	return evalRaw(raw)
end

local httpget=cachedLoad

-- Bundle file lives at CACHE_ROOT/bundle.lua and stores all URLs at once
local BUNDLE_PATH = CACHE_ROOT.."/bundle.lua"

local function writeBundle(entries)
	-- entries: { [url] = raw_string }
	local parts={}
	for url,raw in pairs(entries) do
		parts[#parts+1]=("[\"%s\"]=%q"):format(url:gsub('"','\\"'), raw)
	end
	local out="return {\n"..table.concat(parts,",\n").."\n}"
	pcall(fswrite, BUNDLE_PATH, out)
end

local function readBundle()
	if not cacheReady then return nil end
	if not fsexists(BUNDLE_PATH) then return nil end
	local ok,data=pcall(fsread,BUNDLE_PATH)
	if not ok or not data or #data==0 then return nil end
	local f=loadstring(data)
	if not f then return nil end
	local s,res=pcall(f)
	if not s or type(res)~="table" then return nil end
	return res
end

local function fetchAll(urls)
	-- Try bundle first
	local bundle=readBundle()
	if bundle then
		local missing={}
		for i=1,#urls do
			if bundle[urls[i]]==nil then
				missing[#missing+1]=urls[i]
			end
		end
		if #missing==0 then
			return bundle
		end
		-- fetch only the missing ones and merge
		for i=1,#missing do
			local raw=cachedRaw(missing[i])
			if raw then bundle[missing[i]]=raw end
		end
		writeBundle(bundle)
		return bundle
	end

	-- No bundle: fetch everything in parallel, collect, write bundle
	local results={}
	local remaining=#urls
	if remaining==0 then return results end
	local evt=Instance.new("BindableEvent")
	for i=1,#urls do
		local url=urls[i]
		task.spawn(function()
			local raw=cachedRaw(url)
			if raw then results[url]=raw end
			remaining=remaining-1
			if remaining<=0 then evt:Fire() end
		end)
	end
	evt.Event:Wait()
	evt:Destroy()
	if hasfs then writeBundle(results) end
	return results
end

