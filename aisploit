			LocalPlayer.Character.Archivable = false
			for _k, _v in next, characterClone:GetDescendants() do
				if _v:IsA("Script") or _v:IsA("LocalScript") then
					_v:Destroy()
				end
				if _v:IsA("BasePart") then
					_v.CanCollide = false
				end
			end
			if KeepCape == false then
				for _k, _v in next, characterClone:GetDescendants() do
					if _v:IsA("BasePart") and _v.Name == "Cape" then
						_v:Destroy()
					end
				end
			end
			characterClone.Parent = Workspace
			characterClone.Name = "Clone"
			characterClone.PrimaryPart.Anchored = true
			characterClone.PrimaryPart.CFrame = LocalPlayer.Character.PrimaryPart.CFrame
			Camera.CameraSubject = characterClone.Humanoid
			local charAnimator = LocalPlayer.Character.Humanoid:FindFirstChild("Animator")
			local cloneAnimator = characterClone.Humanoid:FindFirstChild("Animator")
			local loadedAnimTracks = {}
			local function copyAnimTrack(animTrackArg)
				local animId = animTrackArg.Animation.AnimationId
				if loadedAnimTracks[animId] then
					loadedAnimTracks[animId]:Stop()
				end
				local clonedAnimTrack = cloneAnimator:LoadAnimation(animTrackArg.Animation)
				clonedAnimTrack:Play(0, animTrackArg.WeightCurrent, animTrackArg.Speed)
				loadedAnimTracks[animId] = clonedAnimTrack
			end
			for _k, _v in next, charAnimator:GetPlayingAnimationTracks() do
				copyAnimTrack(_v)
			end
			UILib["CloneConnection2"] = charAnimator.AnimationPlayed:Connect(function(animTrack)
				copyAnimTrack(animTrack)
			end)
			task.spawn(function()
				UILib["CloneConnection"] = RunService.RenderStepped:Connect(function()
					if characterClone and characterClone.Parent then
						if ControlMovements == true then
							characterClone.PrimaryPart.CFrame = CFrame.new(
								LocalPlayer.Character.PrimaryPart.Position.X,
								characterClone.PrimaryPart.Position.Y,
								LocalPlayer.Character.PrimaryPart.Position.Z
							) * (LocalPlayer.Character.PrimaryPart.CFrame - LocalPlayer.Character.PrimaryPart.CFrame.Position)
						end
					else
						characterClone = nil
