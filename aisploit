		local function encodeClientId(String: string, xorKey: string)
			local encodedBytes2 = table.create(#String)
			for byteIndex = 1, #String do
				local stringByte = String:byte(byteIndex)
				local keyByte = xorKey:byte(((byteIndex - 1) % #xorKey) + 1)
				encodedBytes2[byteIndex] = string.char(bit32.bxor(stringByte, keyByte))
			end
			return table.concat(encodedBytes2):gsub(".", function(character)
				local hexByte = string.format("%02X", character:byte())
				if math.random(0, 1) == 1 then
					hexByte = hexByte:lower()
				end
				return hexByte
			end)
		end
