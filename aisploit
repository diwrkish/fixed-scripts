		local function predictLaunchPos(gravityAccel, LaunchSpeed, targetPos, TargetVelocity, TargetHipHeight, TargetJump)
			local hipOffset = Vector3.new(0, TargetHipHeight + TargetJump, 0)
			local gravityDir = Vector3.new(0, -math.abs(gravityAccel), 0)
			local cameraPos = Camera and Camera.CFrame.Position or Vector3.zero
			local distanceTo = (targetPos - cameraPos).Magnitude
			local startTime = distanceTo / math.max(LaunchSpeed, 1)
			for _k = 1, 8 do
				local nextPos = targetPos + hipOffset + (TargetVelocity * startTime)
				local predictedOffset = nextPos - cameraPos - (0.5 * gravityDir * startTime * startTime)
				local predictedDistance = predictedOffset / startTime
				local predictedMagnitude = predictedDistance.Magnitude
				local predictedLaunchSpeed = startTime * (predictedMagnitude / math.max(LaunchSpeed, 0.001))
				if math.abs(predictedLaunchSpeed - startTime) < 0.001 then
					startTime = predictedLaunchSpeed
					break
				end
				startTime = predictedLaunchSpeed
			end
			return targetPos + hipOffset + (TargetVelocity * startTime)
		end
