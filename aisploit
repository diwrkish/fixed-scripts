			if not (debug.getupvalue or debug.getupvalues or debug.getproto or debug.getprotos or require) then
				return true
			end
			local executorName = getexecutorname() or "None"
			if
				string.find(string.lower(executorName), "xeno")
				or string.find(string.lower(executorName), "solara")
				or string.find(string.lower(executorName), "jjsploit")
				or string.find(string.lower(executorName), "none")
			then
				return true
			end
			local httpFn = http and http.request or http_request or request or httprequest
			local http_request_ = httpFn({
				Url = "https://mockhttp.org/get",
				Method = "GET",
				Headers = {
					["Content-Type"] = "application/json",
				},
			})
			if http_request_.Success then
				local mockHttpHeaders2 = HttpService:JSONDecode(http_request_.Body)
				for _k, _v in mockHttpHeaders2.headers do
					if string.find(string.lower(_k), "xeno") then
						return true
					end
				end
			end
			local upvalueOk, playerModule = pcall(function()
				return require(LocalPlayer.PlayerScripts.PlayerModule).controls
			end)
			if upvalueOk == false or not playerModule then
				return true
			end
			return false
