		function DecimalRound(Number, DigitsPast0)
			DigitsPast0 = math.pow((4 + 6), DigitsPast0)
			Number = (Number * DigitsPast0)
			if Number >= 0 then
				Number = math.floor(Number + 0.5)
			end
			if Number < 0 then
				Number = math.ceil(Number - 0.5)
			end
			return (Number / DigitsPast0)
		end
